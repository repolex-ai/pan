# ExifTool user config — teaches ExifTool (and every viewer that embeds it:
# Xee³, XnView, digiKam …) the Pan and Copia XMP vocabularies, each with its
# own family-0 group, so they show as "pan:Image properties" and
# "copia:Moment properties" beside "XMP properties". A file carries only these
# two namespaces (goodlux, 2026-09-07); identity and creation time are
# pan:id and pan:dateCreated in the file, git-lex:id and git-lex:dateCreated
# in the graph.
# The image files are untouched; only the reader learns. Install:
#   cp exiftool/ExifTool_config ~/.ExifTool_config
# then restart the viewer (ExifTool reads this once per process).
# See subtexture/docs/pan/2026_09_04_EXIFTOOL_SECTIONS_AND_THE_IMAGE_DATA_STRUCTURE.md
#
# 2026-09-05: Pan's block is FLAT (no `pan:image` wrapper struct), the same
# shape as copia's, so fields label as "Media Path", not "Image Media Path".
# Only the two nested shapes Pan still writes are declared as structs: the
# thumbnail, and the per-stage reference bags (captionData, poseData, …).

%panRef = (
    NAMESPACE   => { 'pan' => 'https://repolex.ai/ontology/pan/' },
    STRUCT_NAME => 'PanRef',
    model => { }, path => { }, count => { }, producedDate => { },
);

# pan — Pan's block about the stored file.
%Image::ExifTool::UserDefined::pan = (
    GROUPS    => { 0 => 'pan:Image', 1 => 'pan:Image', 2 => 'Image' },
    NAMESPACE => { 'pan' => 'https://repolex.ai/ontology/pan/' },
    WRITABLE  => 'string',
    thumbnail => {
        Struct => {
            NAMESPACE   => { 'pan' => 'https://repolex.ai/ontology/pan/' },
            STRUCT_NAME => 'PanThumb',
            path => { }, width => { }, height => { },
        },
    },
    # One entry per model run of a stage: where its data file is, how many
    # items it holds, when it was produced.
    captionData => { List => 'Bag', Struct => \%panRef },
    poseData    => { List => 'Bag', Struct => \%panRef },
    vectorData  => { List => 'Bag', Struct => \%panRef },
    regionData  => { List => 'Bag', Struct => \%panRef },
);

# copia — Horae's Moment block. Namespace and group ONLY: ExifTool picks up
# every copia property present in the file on its own, so the vocabulary can
# grow without touching this file.
%Image::ExifTool::UserDefined::copia = (
    GROUPS    => { 0 => 'copia:Moment', 1 => 'copia:Moment', 2 => 'Image' },
    NAMESPACE => { 'copia' => 'https://repolex.ai/ontology/copia/' },
    WRITABLE  => 'string',
);

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        pan       => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::pan' } },
        copia     => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::copia' } },
    },
);
1;
